# Normalize line endings
* text=auto

# Force LF for source and scripts
*.c text eol=lf
*.h text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.ico binary

# Vendored code -- exclude from language stats
libs/shell/vendor/** linguist-vendored

# Mark docs for GitHub rendering
*.md linguist-documentation=false
docs/** linguist-documentation
